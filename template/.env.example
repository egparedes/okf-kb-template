# Copy to .env (gitignored) and fill in. `kb` loads it; real environment
# variables take precedence.

# Zotero (tier 2): local API first, web API as fallback.
# Read-only key: zotero.org/settings/keys, "Allow library access" only
# ZOTERO_API_KEY=
# Zotero data directory: offline metadata and full text when Zotero is closed
# ZOTERO_DATA_DIR=~/Zotero

# KaraKeep: cloud service or a self-hosted instance - only these two change.
# KARAKEEP_URL=https://karakeep.example.org
# KARAKEEP_API_KEY=

# File roots declared in schema/resources.yaml: map each to exactly the folder
# its description names (never a broader parent folder).
# KB_ROOT_TALKS=~/Documents/Talks
# Extra deny patterns kept out of git because they name sensitive things (`;`-separated)
# KB_DENY=talks/*/private-notes*;papers/reviews/**
# Converter for non-text files when markitdown is not installed (run through uvx)
# KB_MARKITDOWN=markitdown[all]==0.1.8
