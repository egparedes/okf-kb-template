# Copy to .env (gitignored) and fill in. `kb` loads it; real environment
# variables take precedence.

# Zotero (tier 2): local API first, web API as fallback.
# ZOTERO_API_KEY=            # read-only key: zotero.org/settings/keys, "Allow library access" only
# ZOTERO_DATA_DIR=~/Zotero   # data directory, for full text when Zotero is closed

# KaraKeep: cloud service or a self-hosted instance - only these two change.
# KARAKEEP_URL=https://karakeep.example.org
# KARAKEEP_API_KEY=

# File roots declared in schema/resources.yaml
# KB_ROOT_TALKS=~/Documents/Talks
