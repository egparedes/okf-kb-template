<%*
// This file's own frontmatter makes it a conformant OKF concept (type: Template).
// After Templater runs, the hook below replaces the copied frontmatter with the
// real profile of the new note. Edit ACTOR if your human id changes.
const ACTOR = "human:{{ owner_id }}";
const target = tp.config.target_file;
const day = tp.file.title;
const now = tp.date.now("YYYY-MM-DD[T]HH:mm:ssZ");
tp.hooks.on_all_templates_executed(async () => {
  await app.fileManager.processFrontMatter(target, (fm) => {
    for (const key of Object.keys(fm)) delete fm[key];
    fm.type = "Journal Entry";
    fm.title = `Journal ${day}`;
    fm.description = `Journal entry for ${day}.`;
    fm.tags = ["journal"];
    fm.status = "stable";
    fm.generated = { by: ACTOR, at: now };
  });
});
-%>
