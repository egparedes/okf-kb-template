# Task runner for the knowledge base. `just` lists recipes.

set shell := ["bash", "-c"]

kb := "uv run --quiet kb"
# The knowledge-base folder (OKF bundle, Obsidian vault): `[tool.kb] bundle` in pyproject.toml
bundle := `n=$(sed -n '/^\[tool\.kb\]/,/^\[/s/^bundle = "\(.*\)"$/\1/p' pyproject.toml); echo "${n:-kb}"`
# qmd keeps one index per user: name this knowledge base's collection after it (pyproject name `<kb_name>-tools`)
qmd_collection := env("KB_QMD_COLLECTION", `n=$(sed -n 's/^name = "\(.*\)-tools"$/\1/p' pyproject.toml); echo "${n:-kb}"`)
# Independent OKF v0.2 validator (scaccogatto/okf-skills), pinned to a reviewed commit.
okf_validator := "https://raw.githubusercontent.com/scaccogatto/okf-skills/68ce7a0c07f66ca9a6b0beb68937d75314d5e8a5/skills/validate/scripts/okf_validate.py"

default:
    @just --list

# Install Python tooling and git hooks (initializes git if needed)
setup:
    git rev-parse --git-dir >/dev/null 2>&1 || git init -q
    uv sync
    uv run pre-commit install
    {{kb}} index

# Validate OKF conformance and house rules (optionally only the given files)
[positional-arguments]
check *files:
    {{kb}} check "$@"

# Normalize links to /bundle-absolute form, then regenerate every index.md
fix:
    {{kb}} fix-links
    {{kb}} index

# Regenerate every index.md from frontmatter
index:
    {{kb}} index

# Independent second opinion on OKF conformance (fails on spec violations; warnings such as wanted pages are tolerated, as OKF §11 requires)
validate-okf:
    uv run --quiet {{okf_validator}} {{quote(bundle)}}

# Health report: trust tiers, stale pages, uncited pages, unused sources, wanted pages
report:
    {{kb}} report

# Maintenance candidates (read-only): report, link graph, near-duplicates, unlinked mentions
health:
    {{kb}} report
    {{kb}} graph
    {{kb}} dupes
    {{kb}} unlinked

# List pages by frontmatter, e.g. `just find --type Concept --tag distributed-systems`
[positional-arguments]
find *args:
    {{kb}} find "$@"

# Check external URLs (source rot); needs lychee
links-online:
    lychee --no-progress --scheme https --scheme http --accept '200..=299,403,429' --root-dir "{{justfile_directory()}}/{{bundle}}" --exclude-path {{quote(bundle + "/.obsidian")}} {{quote(bundle + "/**/*.md")}}

# Search: qmd hybrid search when set up, otherwise ripgrep over the words of the query
[positional-arguments]
search +query:
    @if command -v qmd >/dev/null && qmd collection list 2>/dev/null | grep -qF -- {{quote("(qmd://" + qmd_collection + "/)")}}; then \
        qmd query "$*" -c {{quote(qmd_collection)}}; \
    else \
        args=(); for term in $*; do term="${term//[^[:alnum:]_-]/}"; [ ${#term} -ge 3 ] && args+=(-e "$term"); done; \
        [ ${#args[@]} -eq 0 ] && args=(-F -e "$*"); \
        rg --ignore-case --count-matches --glob '!**/index.md' "${args[@]}" {{quote(bundle)}} | sort -t: -k2 -nr | head -20 || true; \
    fi

# One-time qmd setup: collection, per-folder contexts from taxonomy, embeddings
search-setup:
    qmd collection add {{quote(bundle)}} --name {{quote(qmd_collection)}} --mask "**/*.md"
    qmd context add {{quote("qmd://" + qmd_collection)}} "Knowledge base (OKF v0.2 bundle). Start from the index.md files."
    {{kb}} folders | while IFS="$(printf '\t')" read -r folder description; do qmd context add {{quote("qmd://" + qmd_collection)}}"/$folder" "$description"; done
    qmd embed

# Refresh the qmd index after changes
search-reindex:
    qmd update
    qmd embed

# Install the vault's pinned Obsidian community plugins; e.g. `just obsidian-setup --open` or `--add omnisearch`
obsidian-setup *args:
    {{kb}} obsidian setup {{args}}

# Rename the knowledge-base folder (and so the Obsidian vault), e.g. `just rename-bundle my-notes`; close Obsidian first
rename-bundle new:
    #!/usr/bin/env bash
    set -euo pipefail
    old={{quote(bundle)}}; new={{quote(new)}}
    fail() { echo "rename-bundle: $*" >&2; exit 1; }
    [[ "$new" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]] || fail "use lowercase kebab-case"
    case "$new" in
        schema|tools|docs|imports|template|launcher|site) fail "$new is already a folder of the repository";;
        sources|syntheses|entities|projects|journal) fail "$new is a standard folder inside the knowledge base; pick another name";;
    esac
    [ "$old" != "$new" ] || { echo "rename-bundle: already named $new"; exit 0; }
    [ -d "$old" ] || fail "$old/ not found"
    [ ! -e "$new" ] || fail "$new already exists"
    [ ! -e "$old/$new" ] || fail "$old/ already has a folder named $new (a domain?); pick another name, e.g. $new-kb"
    ref=$(sed -n 's/^_commit: *//p' .copier-answers.yml)
    [ -n "$ref" ] || fail "no _commit in .copier-answers.yml: cannot tell which template version to re-render"
    # copier recopy rewrites template-managed files, so those must be committed. Edits to pages
    # and vault settings inside the folder are fine: they move with it.
    # (two calls: an :(exclude) pathspec would also hide $old/_templates)
    dirty=$(git status --porcelain --untracked-files=no -- . ":(exclude)$old"; git status --porcelain --untracked-files=no -- "$old/_templates")
    [ -z "$dirty" ] || fail "commit or stash these changes first:"$'\n'"$dirty"
    # git mv stages the renames and keeps history; untracked notes and installed plugins move with the folder.
    if [ -n "$(git ls-files -- "$old" | head -n 1)" ]; then git mv -- "$old" "$new"; mover=(git mv --); else mv -- "$old" "$new"; mover=(mv --); fi
    rollback() {
        "${mover[@]}" "$new" "$old"
        git restore --source=HEAD --staged --worktree -- . ":(exclude)$old" 2>/dev/null || true
        git restore --source=HEAD --staged --worktree -- "$old/_templates" 2>/dev/null || true
    }
    # Re-render the template-managed files (pyproject, .gitignore, agent docs, ...) with the new name.
    if ! uvx --quiet copier recopy --quiet --trust --defaults --overwrite --skip-tasks --vcs-ref="$ref" --data bundle_dir="$new" .; then
        rollback
        fail "copier recopy failed (see above); everything was put back as it was"
    fi
    trap 'echo "rename-bundle: stopped after moving $old/ to $new/ and re-rendering; run uv sync and just index, then review git diff --cached" >&2' ERR
    # Managed files whose change is more than the folder name had local edits: the re-render reverted them.
    # Pure renames keep the same words, one for one, with only old -> new differing.
    reverted=$(uv run --quiet python - "$old" "$new" <<'PY'
    import re, subprocess, sys
    old, new = sys.argv[1:3]
    words = lambda text: re.split(r"([\w-]+)", text)
    changed = subprocess.run(["git", "diff", "--name-only", "-z", "--", ".", f":(exclude){new}", ":(exclude).copier-answers.yml"], capture_output=True, text=True).stdout
    for path in filter(None, changed.split("\0")):
        head = subprocess.run(["git", "show", f"HEAD:{path}"], capture_output=True, text=True, errors="replace")
        try:
            current = open(path, encoding="utf-8", errors="replace").read()
        except OSError:
            current = ""
        a, b = words(head.stdout), words(current)
        if head.returncode != 0 or len(a) != len(b) or any(x != y and (x, y) != (old, new) for x, y in zip(a, b)):
            print(path)
    PY
    )
    git add -u -- . ":(exclude)$new"   # tracked files only: untracked work stays unstaged
    [ ! -d "$new/_templates" ] || git add -u -- "$new/_templates"
    if [ -f .cache/kb-touched.txt ]; then  # the Stop hook's list of pages this agent session changed
        uv run --quiet python - "$(pwd -P)" "$old" "$new" <<'PY'
    import sys
    from pathlib import Path
    root, old, new = sys.argv[1:4]
    touched = Path(".cache/kb-touched.txt")
    before, after = f"{root}/{old}/", f"{root}/{new}/"
    lines = touched.read_text(encoding="utf-8").splitlines()
    touched.write_text("".join(after + l[len(before):] + "\n" if l.startswith(before) else l + "\n" for l in lines), encoding="utf-8")
    PY
    fi
    uv sync --quiet
    {{kb}} index >/dev/null
    echo "Renamed $old/ to $new/ and staged the move and the re-rendered template files."
    if [ -n "$reverted" ]; then
        echo "WARNING: these template-managed files had local edits that the re-render reverted (see git diff --cached):"
        while IFS= read -r path; do echo "  $path"; done <<< "$reverted"
    fi
    echo "Next: review git diff --cached, then commit. Your unstaged edits and untracked notes are untouched;"
    echo "note that the pre-commit hook also checks untracked pages: one without valid frontmatter blocks the commit."
    echo "By hand: mentions of $old/ in README.md and in schema/*.yaml comments (not re-rendered)."
    [ ! -d "$new/.obsidian" ] || echo "Obsidian: open $new/ with Open folder as vault."
    ! command -v qmd >/dev/null || echo "qmd: qmd collection remove {{qmd_collection}} && just search-setup"

# Run the tooling tests
test:
    uv run --quiet pytest -q

# Everything CI runs
ci: check validate-okf test
    {{kb}} index --check
